            </td>

        </tr>
    }
    </tbody>

    <!-- SS3 Pagination Improvement-->

    <div class="mt-3">

        @if (ViewBag.HasPreviousPage)
        {
            <a asp-action="Index"
               asp-route-page="@(ViewBag.CurrentPage - 1)"
               class="btn btn-secondary">
                Previous
            </a>
        }

        <span class="mx-2">
            Page @ViewBag.CurrentPage
        </span>

        @if (ViewBag.HasNextPage)
        {
            <a asp-action="Index"
               asp-route-page="@(ViewBag.CurrentPage + 1)"
               class="btn btn-secondary">
                Next
            </a>
        }

    </div>

