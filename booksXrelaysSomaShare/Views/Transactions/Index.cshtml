@model IEnumerable<booksXrelaysSomaShare.Models.Transaction>

@{
    ViewData["Title"] = "Transactions";
}

<h1>Transactions</h1>

<!-- SS3 Display transaction Improvement -->
<div class="card mb-4">
    <div class="card-body">

        <h4>Transaction Statistics</h4>

        <p>
            <strong>Total Transactions:</strong>
            @Model.Count()
        </p>

        <p>
            <strong>Completed Transactions:</strong>
            @Model.Count(t => t.IsCompleted)
        </p>

        <p>
            <strong>Pending Transactions:</strong>
            @Model.Count(t => !t.IsCompleted)
        </p>

    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create New Transaction
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No transactions found.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">

        <thead class="table-light">
            <tr>
                <th>Book Name</th>
                <th>Offer Price</th>
                <th>Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.BookTitle
                    </td>

                    <!-- Display agreed offer price -->
                    <td>
                        R @item.OfferPrice
                    </td>

                    <td>
                        @item.TransactionDate.ToString("dd MMM yyyy")
                    </td>

                    <!-- Display transaction completion status -->
                    <td>

                        @if (item.IsCompleted)
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }

                    </td>

                    <td>

                        <!-- Only show Complete button for pending transactions -->
                        @if (item.IsCompleted)
                        {
                            <span class="badge bg-success">
                                Accepted Offer
                            </span>
                        }

                        <a asp-action="Edit"
                           asp-route-id="@item.TransactionId"
                           class="btn btn-primary btn-sm">
                            Edit
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.TransactionId"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.TransactionId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}